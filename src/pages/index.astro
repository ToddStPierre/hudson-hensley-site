---
import Base from "../layouts/Base.astro";
import Seo from "../components/Seo.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import TrailerFeature from "../components/TrailerFeature.astro";
import AwardStrip from "../components/AwardStrip.astro";
import FilmTV from "../components/FilmTV.astro";
import Press from "../components/Press.astro";
import About from "../components/About.astro";
import Representation from "../components/Representation.astro";
import Footer from "../components/Footer.astro";
import { loadSite } from "../content/site.schema.ts";
import "../styles/global.css";
const site = loadSite();
---
<Base title="Hudson Hensley — Actor" description={site.tagline}>
  <Seo slot="head" />
  <Nav />
  <main>
    <Hero />
    <TrailerFeature />
    <AwardStrip />
    <FilmTV />
    <Press />
    <About />
    <Representation />
  </main>
  <Footer />
  <script src="../scripts/reveal.js"></script>
</Base>
