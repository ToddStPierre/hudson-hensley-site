---
import { loadSite } from "../content/site.schema.ts";
const site = loadSite();
const ld = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: "Actor",
  sameAs: site.socials.map((s) => s.url),
};
---
<meta property="og:type" content="website" />
<meta property="og:title" content="Hudson Hensley — Actor" />
<meta property="og:description" content={site.tagline} />
<meta property="og:url" content="https://hudsonhensley.com/" />
<meta property="og:image" content="https://hudsonhensley.com/og-image.jpg" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
