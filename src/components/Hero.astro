---
import { Image } from "astro:assets";
import { loadSite } from "../content/site.schema.ts";
import hero from "../assets/hero.jpg";
const site = loadSite();
---
<section id="home" class="hero">
  <Image src={hero} alt={site.hero.imageAlt} widths={[640, 960, 1400, 2000]} sizes="100vw" fetchpriority="high" loading="eager" class="hero__img" />
  <div class="hero__scrim"></div>
  <div class="container hero__body">
    <h1>{site.name}</h1>
    <p class="hero__tagline">{site.tagline}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="#song-sung-blue">{site.hero.ctaTrailer}</a>
      <a class="btn btn--imdb" href={site.hero.imdbUrl} target="_blank" rel="noopener">IMDb</a>
    </div>
  </div>
  <a class="hero__scrollcue" href="#song-sung-blue" aria-hidden="true" tabindex="-1">▾</a>
</section>
<style>
  .hero { position:relative; min-height:100svh; display:grid; align-items:end; color:var(--on-navy); overflow:hidden; }
  .hero__img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 20%; }
  .hero__scrim { position:absolute; inset:0; background:linear-gradient(180deg, rgba(4,26,51,.15) 0%, rgba(4,26,51,.35) 45%, rgba(4,26,51,.85) 100%); }
  .hero__body { position:relative; padding-block:var(--space-8) var(--space-10); }
  .hero h1 { font-size:var(--step-6); text-transform:uppercase; margin:0 0 var(--space-2); }
  .hero__tagline { font-size:var(--step-2); font-weight:300; max-width:34ch; margin:0 0 var(--space-4); }
  .hero__cta { display:flex; gap:var(--space-2); flex-wrap:wrap; }
  .hero__scrollcue { position:absolute; left:50%; bottom:var(--space-3); transform:translateX(-50%); color:var(--on-navy); font-size:1.5rem; text-decoration:none; }
  @media (prefers-reduced-motion: no-preference) { .hero__scrollcue { animation:bob 1.8s ease-in-out infinite; } @keyframes bob { 50% { transform:translate(-50%, 6px); } } }
</style>
