---
import { Image } from "astro:assets";
import { loadSite } from "../content/site.schema.ts";
import poster from "../assets/still-song-sung-blue.jpg";
const { feature } = loadSite();
---
<section id="song-sung-blue" class="section feature">
  <div class="container">
    <h2>{feature.heading}</h2>
    <div class="feature__grid">
      <div class="trailer" data-youtube-id={feature.youtubeId}>
        <Image src={poster} alt={feature.posterAlt} widths={[480, 800, 1200]} sizes="(min-width:720px) 60vw, 100vw" class="trailer__poster" />
        <button class="trailer__play" aria-label={`Play the ${feature.heading} trailer`}>▶</button>
      </div>
      <p class="feature__body">{feature.body}</p>
    </div>
  </div>
</section>
<style>
  .feature { background:var(--paper); }
  .feature__grid { display:grid; gap:var(--space-4); }
  @media (min-width:720px) { .feature__grid { grid-template-columns:60% 1fr; align-items:center; } }
  .trailer { position:relative; aspect-ratio:16/9; border-radius:var(--radius); overflow:hidden; background:var(--navy-900); }
  .trailer__poster { width:100%; height:100%; object-fit:cover; }
  .trailer__play { position:absolute; inset:0; margin:auto; width:72px; height:72px; border-radius:50%; border:0; font-size:1.5rem; color:var(--on-navy); background:var(--blue); cursor:pointer; }
  .trailer__play:hover { background:var(--blue-hover); }
  .trailer iframe { width:100%; height:100%; border:0; }
  .feature__body { font-size:var(--step-1); }
</style>
<script src="../scripts/trailer.js"></script>
